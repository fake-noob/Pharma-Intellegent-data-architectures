    {
      "id": 20,
      "type": "stat",
      "title": "Coverage gaps",
      "description": "Calendar months between the first and last date that have no data. 0 means the time range is fully covered.",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(\"months missing\"), 0) FROM (\nWITH cov AS (\n  SELECT 'Pharmacy sales' AS fact, t.min_date, t.max_date,\n         (SELECT count(DISTINCT year_month) FROM mart.agg_sales_month) AS months_present\n  FROM mart.table_stats t WHERE t.table_name = 'fact_sales'\n  UNION ALL\n  SELECT 'Hospital demand', t.min_date, t.max_date,\n         (SELECT count(DISTINCT year_month) FROM mart.agg_hospital_demand_month)\n  FROM mart.table_stats t WHERE t.table_name = 'fact_hospital_demand')\nSELECT fact, min_date::text AS \"first date\", max_date::text AS \"last date\", months_present AS \"months present\",\n       ((extract(year FROM max_date) - extract(year FROM min_date)) * 12\n        + extract(month FROM max_date) - extract(month FROM min_date) + 1)::int AS \"months expected\",\n       ((extract(year FROM max_date) - extract(year FROM min_date)) * 12\n        + extract(month FROM max_date) - extract(month FROM min_date) + 1)::int - months_present AS \"months missing\"\nFROM cov) c",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#10B981",
                "value": null
              },
              {
                "color": "#EF4444",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "✔ none",
                  "color": "#10B981"
                }
              }
            }
          ],
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      }
