          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT run, \"Total query time (ms)\" FROM (\n                   SELECT min(started_at_utc) AS started, to_char(min(started_at_utc), 'MM-DD HH24:MI') AS run,\n                          round(sum(duration_ms)::numeric) AS \"Total query time (ms)\"\n                   FROM mart.etl_query_log WHERE $__timeFilter(started_at_utc) GROUP BY run_id ORDER BY 1 DESC LIMIT 12) r\n                 ORDER BY started",
          "refId": "A"
