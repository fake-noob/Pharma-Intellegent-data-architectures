          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT min(started_at_utc) AS time, round(sum(duration_ms)::numeric) AS \"Total query time (ms)\"\n                   FROM mart.etl_query_log WHERE $__timeFilter(started_at_utc) GROUP BY run_id ORDER BY 1",
          "refId": "A"
