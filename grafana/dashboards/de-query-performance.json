    {
      "id": 27,
      "type": "barchart",
      "title": "Average execution time per query (ms)",
      "description": "Slowest query first: a long bar points at an unoptimised join or a missing summary table.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT query_name AS query, round(avg(duration_ms)::numeric, 1) AS \"Average time (ms)\"\n                 FROM mart.etl_query_log WHERE status = 'ok' AND $__timeFilter(started_at_utc)\n                 GROUP BY 1 ORDER BY 2 DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "custom": {
            "fillOpacity": 90,
            "lineWidth": 0,
            "gradientMode": "none",
            "axisBorderShow": false,
            "axisPlacement": "auto",
            "axisGridShow": true,
            "axisColorMode": "text",
            "axisCenteredZero": false,
