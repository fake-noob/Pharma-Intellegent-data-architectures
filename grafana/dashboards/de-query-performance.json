    {
      "id": 28,
      "type": "timeseries",
      "title": "Total query time per verification run (ms)",
      "description": "One point per run of the full query set. A rise after a refresh shows the cost of the added data.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "targets": [
