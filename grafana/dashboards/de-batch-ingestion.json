    {
      "id": 5,
      "type": "stat",
      "title": "Median load speed",
      "description": "Median of rows / load duration across batches.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(percentile_cont(0.5) WITHIN GROUP (ORDER BY rows_loaded / duration_seconds))\n                 FROM staging.ingest_batch WHERE status IN ('loaded', 'validated') AND duration_seconds > 0 AND $__timeFilter(started_at)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
