          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT file_name || ' (#' || batch_id || ')' AS batch, duration_seconds AS \"Load duration (s)\"\n                 FROM staging.ingest_batch WHERE status IN ('loaded', 'validated') AND $__timeFilter(started_at)\n                 ORDER BY duration_seconds DESC LIMIT 12",
