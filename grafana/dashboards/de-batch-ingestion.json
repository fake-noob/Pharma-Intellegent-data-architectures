          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT started_at AS time, source_name AS metric, round(rows_loaded / duration_seconds) AS speed\n                   FROM staging.ingest_batch WHERE status IN ('loaded', 'validated') AND duration_seconds > 0 AND $__timeFilter(started_at)\n                   ORDER BY 1",
