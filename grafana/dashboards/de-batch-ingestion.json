  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Batch success rate",
      "description": "Successful batches / attempted batches x 100. A batch is one file load; duplicates that were skipped are not attempts.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE status IN ('loaded', 'validated'))\n                       / NULLIF(count(*) FILTER (WHERE status IN ('loaded','validated','failed')), 0), 1)\n                 FROM staging.ingest_batch WHERE $__timeFilter(started_at)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 90
              },
              {
                "color": "#0ca30c",
                "value": 99.9
              }
            ]
          },
          "mappings": [],
          "noValue": "No data",
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
