    {
      "id": 44,
      "type": "barchart",
      "title": "Sales fact rows after each publish",
      "description": "Total rows in the sales fact at each of the last 12 publishes (oldest left). A step up is a refresh landing: history is kept and new rows are added.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT publish, \"Sales rows\" FROM (\n                  SELECT published_at, to_char(published_at, 'MM-DD HH24:MI') AS publish, fact_sales_rows AS \"Sales rows\"\n                  FROM mart.publish_log ORDER BY published_at DESC LIMIT 12) t ORDER BY published_at",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#06B6D4"
          },
          "custom": {
            "fillOpacity": 90,
            "lineWidth": 0,
            "gradientMode": "none",
            "axisBorderShow": false,
            "axisPlacement": "auto",
            "axisGridShow": true,
            "axisColorMode": "text",
            "axisCenteredZero": false,
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "locale",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "showValue": "never",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.5,
        "barRadius": 0.15,
        "fullHighlight": false,
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "legend": {
          "showLegend": false,
