    {
      "id": 50,
      "type": "row",
      "title": "Files staged, newest first",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 47,
      "type": "table",
      "title": "Batches, newest first",
      "description": "Every file staged, newest first: refresh files appear here as they land.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT batch_id, source_name AS source, file_name AS file, status, rows_loaded,\n                        duration_seconds AS seconds, started_at AS started\n                 FROM staging.ingest_batch ORDER BY batch_id DESC LIMIT 12",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "loaded": {
                        "text": "✔ loaded",
                        "color": "#10B981",
                        "index": 0
                      },
                      "validated": {
                        "text": "✔ validated",
                        "color": "#10B981",
                        "index": 1
                      },
                      "failed": {
                        "text": "✖ failed",
                        "color": "#EF4444",
                        "index": 2
                      },
                      "skipped_duplicate": {
                        "text": "↷ skipped duplicate",
                        "color": "text",
                        "index": 3
                      },
                      "running": {
                        "text": "… running",
                        "color": "#F59E0B",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rows_loaded"
            },
            "properties": [
              {
                "id": "unit",
                "value": "locale"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      }
