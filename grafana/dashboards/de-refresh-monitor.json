    {
      "id": 46,
      "type": "trend",
      "title": "Net sales per month (USD)",
      "description": "Net sales by month from the warehouse's monthly aggregate: new months appear after each refresh. Jan-Feb 2023 are a ramp-up (sales data starts 2023-01-30).",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT extract(epoch FROM to_date(year_month, 'YYYY-MM')) * 1000 AS month,\n                       round(sum(net_sales_amount_usd), 0) AS \"Net sales (USD)\"\n                FROM mart.agg_sales_month GROUP BY year_month ORDER BY year_month",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#06B6D4"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "lineInterpolation": "linear",
            "barAlignment": 0,
            "fillOpacity": 90,
            "showPoints": "never",
            "pointSize": 6,
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisGridShow": true,
            "axisBorderShow": false,
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "currencyUSD",
          "noValue": "No data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "month"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:MMM YY"
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "month",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
